  "cards": [
    {
      "dot": "cyan",
      "title": "Inputs",
      "items": [
        "Each script also takes the run's YAML config, which names the model and the eval transform",
        "Checkpoints hold the class names, so predictions are named, not numbered"
      ]
    },
    {
      "dot": "emerald",
      "title": "Export",
      "items": [
        "export_onnx checks ONNX Runtime's outputs against PyTorch's",
        "model.onnx stores the class names and the eval transform's settings as metadata"
      ]
    },
    {
      "dot": "violet",
      "title": "Serving",
      "items": [
        "The server repeats the eval transform with PIL and numpy, as its image has no torchvision",
        "A test checks that its probabilities equal PyTorch's"
      ]
    }
  ]
