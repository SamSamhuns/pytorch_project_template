  "cards": [
    {
      "dot": "cyan",
      "title": "Config and run",
      "items": [
        "load_config reads the YAML in struct mode, so a mistyped key raises",
        "Each run saves its config.yaml, logs and checkpoints to save_dir/experiment_name/RUN_ID"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data and model",
      "items": [
        "build_transforms gives the train and eval transforms of dataset.preprocess",
        "DATASETS and MODELS map the config's type names to project classes"
      ]
    },
    {
      "dot": "violet",
      "title": "Training",
      "items": [
        "ClassifierTrainer builds the loss, optimizer and LR scheduler the config names in torch",
        "fit() validates every valid_freq epochs and saves best.pth when the val accuracy improves",
        "-r last.pth restores the weights, optimizer, LR schedule and epoch"
      ]
    }
  ]
